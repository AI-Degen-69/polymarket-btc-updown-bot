{
  "name": "polymarket-updown-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "5-minute strategy bot for Polymarket BTC 5m/15m Up-or-Down markets",
  "scripts": {
    "dev": "bun --cwd web dev",
    "build:web": "bun --cwd web build",
    "scan": "bun run src/index.ts scan",
    "run": "bun run src/index.ts run",
    "status": "bun run src/index.ts status",
    "dashboard": "bun run src/dashboard.ts",
    "api": "bun run src/dashboard.ts",
    "reset": "bun run src/index.ts reset",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "replay:guide": "bun run scripts/replay-guide.ts"
  },
  "dependencies": {
    "@polymarket/client": "latest",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
